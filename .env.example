# ===== Database =====
# For local development (SQLite - default, no config needed)
# DATABASE_URL=sqlite:///./data/app.db

# For production (PostgreSQL on AWS RDS)
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/news_classifier

# ===== AWS (optional) =====
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=news-classifier-models

# ===== App Settings =====
# SECRET_KEY=change-this-to-a-random-string
# DEBUG=False
